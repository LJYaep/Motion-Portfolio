# Copy to server.env and fill these values on the machine running the backend.
# Never put passwords or webhook URLs in HTML, CSS or script.js.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_USERNAME=daniljy.aep@gmail.com
SMTP_PASSWORD=
SMTP_FROM=daniljy.aep@gmail.com

# Optional Discord notification channel. Create a private incoming webhook.
DISCORD_WEBHOOK_URL=
# Optional numeric Discord user ID to mention in each notification.
DISCORD_NOTIFY_USER_ID=
# Optional public Discord profile/invite URL for the contact button.
DISCORD_CONTACT_URL=

# Empty means same-origin requests only. Set exact HTTPS origins if needed.
ALLOWED_ORIGINS=
# Hosted deployment: bind to 0.0.0.0 behind an HTTPS reverse proxy.
BIND_HOST=127.0.0.1
# 0 selects a free local port. Use a fixed port on your hosting server.
PORT=0
# Optional path outside the public/static tree for production persistence.
ENQUIRY_DB_PATH=
